# Target model configuration — same env var convention used across
# llm_red_teaming, genai_capability_bench, and multi_agent_otel_eval,
# so one .env works for every adapter this repo calls into.
#
# For the time being this repo targets Azure OpenAI only. An Anthropic/Claude
# target is planned (see README.md#target-systems) and will read ANTHROPIC_API_KEY.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_VERSION=
TARGET_MODEL=

# JUDGE_MODEL: the model that scores/reviews TARGET_MODEL's output (judge_review,
# semantic-consistency entailment checks, the agentic evaluator's judge_llm, and
# any scenario's LLM-judge rubric). Must be a genuinely different deployment than
# TARGET_MODEL — a model judging its own output isn't an independent check. If
# unset, scenario code falls back to TARGET_MODEL (same-model-family judging,
# a documented limitation, not the intended default).
JUDGE_MODEL=

# DRIFT_MODEL_SEQUENCE: drift-detection scenario only (docs/drift_detection.md).
# A chronological lineage of dated snapshots from the same model family — the
# "time axis" this scenario sweeps, since a single sitting can't wait for real
# calendar time to pass. Format: ISO_DATE:deployment_name, comma-separated,
# oldest first, e.g. 2025-08-07:gpt-4o-2025-08-07,2025-11-20:gpt-4o-2025-11-20.
# Needs at least 2 entries; more gives a finer-grained trajectory. Each date is
# the real vendor snapshot date (not confidential, and shown as-is in reports —
# only the deployment name is masked); the sequence's date deltas become the
# report's generic "Snapshot N (+Xd)" labels, never the real names.
DRIFT_MODEL_SEQUENCE=
# DRIFT_FLOATING_MODEL: optional. An undated, auto-updating alias from the
# same family, compared against the last (most recent) entry in
# DRIFT_MODEL_SEQUENCE above — a cheap stand-in for calendar/silent drift
# (a floating alias can change behavior with no version bump to see), without
# waiting for real time to pass. Leave blank to skip this secondary check.
DRIFT_FLOATING_MODEL=

# Optional — only needed if your endpoint is an Azure APIM gateway rather
# than a native *.openai.azure.com endpoint. Set BOTH prefixes to the same
# values: llm_red_teaming's client reads the AZURE_ prefix, genai_capability_bench's
# reads the OPENAI_ prefix — adapters in this repo may call into either.
AZURE_APIM_HEADER_NAME=
AZURE_APIM_SUBSCRIPTION_KEY=
OPENAI_APIM_HEADER_NAME=
OPENAI_APIM_SUBSCRIPTION_KEY=

# multi_agent_otel_eval (agentic-system scenarios) — adapters/agent_otel.py sets
# AGENT_MODEL to TARGET_MODEL (the system under test) and AGENT_TEMPERATURE/
# JUDGE_TEMPERATURE to 1 automatically (reasoning-family models like the gpt-5
# family reject any other value). JUDGE_MODEL above is passed through as this
# sibling repo's judge_llm too. Leave the two lines below commented out —
# uncommenting with a blank value would set an empty-string env var that
# breaks Config's float() parsing; only uncomment if you're setting an actual
# override value.
# AGENT_TEMPERATURE=1
# JUDGE_TEMPERATURE=1
