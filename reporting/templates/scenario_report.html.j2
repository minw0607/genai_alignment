<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ report.scenario_name }} — GenAI Alignment Testing Report</title>
<style>
  :root {
    --tier-color: {{ tier_color }};
    --ink: #1b1f23;
    --muted: #5b6470;
    --border: #e2e5e9;
    --bg-soft: #f7f8fa;
    --pass: #2a9d8f;
    --fail: #e76f51;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: #ffffff;
    margin: 0;
    line-height: 1.55;
  }
  .page { max-width: 960px; margin: 0 auto; padding: 0 24px 64px; }
  header.report-header {
    border-top: 6px solid var(--tier-color);
    background: var(--bg-soft);
    padding: 28px 24px;
    margin-bottom: 32px;
  }
  header.report-header .inner { max-width: 960px; margin: 0 auto; }
  .tier-badge {
    display: inline-block;
    background: var(--tier-color);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
  }
  h1 { font-size: 28px; margin: 0 0 6px; }
  .meta { color: var(--muted); font-size: 13px; margin-top: 10px; }
  .meta a { color: var(--muted); }
  .risk-goal { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 18px; }
  .risk-goal .card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
  .risk-goal .card .label { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; margin-bottom: 4px; }
  section { margin-bottom: 40px; }
  h2 { font-size: 19px; border-bottom: 2px solid var(--border); padding-bottom: 8px; margin-bottom: 16px; }
  h3 { font-size: 15px; color: var(--muted); margin: 18px 0 8px; }
  .metrics-row { display: flex; flex-wrap: wrap; gap: 14px; }
  .metric-card {
    flex: 1 1 140px;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px;
    text-align: center;
    background: var(--bg-soft);
  }
  .metric-card .value { font-size: 30px; font-weight: 700; color: var(--tier-color); }
  .metric-card .label { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .metric-card .sublabel { font-size: 11px; color: var(--muted); margin-top: 2px; }
  table.kv { border-collapse: collapse; width: 100%; }
  table.kv td { padding: 6px 10px; border-bottom: 1px solid var(--border); font-size: 14px; }
  table.kv td:first-child { color: var(--muted); width: 220px; }
  .data-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .data-card { border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
  .data-card .layer-tag { display: inline-block; font-size: 11px; font-weight: 600; color: var(--tier-color); margin-bottom: 6px; }
  .data-card .source, .data-card .size { font-size: 12px; color: var(--muted); }
  table.report-table { border-collapse: collapse; width: 100%; font-size: 13px; margin: 10px 0 4px; }
  table.report-table th, table.report-table td { border: 1px solid var(--border); padding: 6px 9px; text-align: left; }
  table.report-table th { background: var(--bg-soft); font-weight: 600; }
  table.report-table tr:nth-child(even) { background: #fbfbfc; }
  .chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-top: 14px; }
  .chart-card { border: 1px solid var(--border); border-radius: 8px; padding: 12px; }
  .chart-card img { width: 100%; height: auto; display: block; border-radius: 4px; }
  .chart-card .caption { font-size: 12px; color: var(--muted); margin-top: 8px; }
  ul.report-list { padding-left: 20px; margin: 0; }
  ul.report-list li { margin-bottom: 10px; }
  ul.report-list.highlight { padding-left: 0; list-style: none; }
  ul.report-list.highlight li {
    border-left: 3px solid var(--fail);
    background: #fff5f2;
    border-radius: 4px;
    padding: 10px 14px;
    margin-bottom: 10px;
  }
  p.exec-summary { font-size: 15px; }
  p.muted { color: var(--muted); font-size: 13px; }
  .toc { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .toc a { color: var(--muted); margin-right: 12px; }
  code { background: var(--bg-soft); padding: 1px 5px; border-radius: 4px; font-size: 90%; }
  details.appendix-block { margin-bottom: 22px; }
  details.appendix-block summary { cursor: pointer; font-size: 15px; color: var(--muted); margin: 18px 0 8px; }
  footer { color: var(--muted); font-size: 12px; border-top: 1px solid var(--border); padding-top: 16px; margin-top: 48px; }
  @media print {
    header.report-header { background: none; }
    .chart-card, .data-card, .metric-card { break-inside: avoid; }
  }
</style>
</head>
<body>
<header class="report-header">
  <div class="inner">
    <div class="tier-badge">{{ report.tier }}</div>
    <h1>{{ report.scenario_name }}</h1>
    <div class="risk-goal">
      <div class="card"><div class="label">Risk if untested</div>{{ report.risk }}</div>
      <div class="card"><div class="label">What "pass" means</div>{{ report.goal }}</div>
    </div>
    <div class="meta">
      Generated {{ report.generated_at }}
      {% if report.notebook_link %} · <a href="{{ report.notebook_link }}">notebook</a>{% endif %}
      {% if report.doc_link %} · <a href="{{ report.doc_link }}">scenario design doc</a>{% endif %}
    </div>
    <div class="toc">
      <a href="#executive-summary">Executive Summary</a>
      <a href="#key-findings">Key Findings</a>
      <a href="#testing-scope">Testing Scope</a>
      <a href="#testing-approach">Testing Approach</a>
      <a href="#results-summary">Results Summary</a>
      {% if high_risk_cases_html %}<a href="#high-risk-cases">High-Risk Cases</a>{% endif %}
      <a href="#next-steps">Next Steps</a>
      <a href="#appendix">Appendix</a>
    </div>
  </div>
</header>

<div class="page">

  <section id="executive-summary">
    <h2>Executive Summary</h2>
    <p class="exec-summary">{{ executive_summary_html }}</p>
  </section>

  <section id="key-findings">
    <h2>Key Findings</h2>
    {% if observations_html %}
    <ul class="report-list">
      {% for o in observations_html %}<li>{{ o }}</li>{% endfor %}
    </ul>
    {% else %}
    <p class="muted">No findings flagged in this run.</p>
    {% endif %}
  </section>

  <section id="testing-scope">
    <h2>Testing Scope</h2>
    <h3>Target</h3>
    <table class="kv">
      {% for k, v in report.target_summary.items() %}
      <tr><td>{{ k }}</td><td>{{ v }}</td></tr>
      {% endfor %}
    </table>
    <h3>Testing Data</h3>
    <div class="data-cards">
      {% for d in report.data_sections %}
      <div class="data-card">
        <div class="layer-tag">{{ d.layer }}</div>
        <div><strong>{{ d.name }}</strong></div>
        <div class="source">{{ d.source }}</div>
        <div class="size">{{ d.size }}</div>
        <p>{{ d.description }}</p>
      </div>
      {% endfor %}
    </div>
    {% if data_charts %}
    <div class="chart-grid">
      {% for c in data_charts %}
      <div class="chart-card">
        <img src="data:image/png;base64,{{ c.base64_png }}" alt="{{ c.title }}">
        <div class="caption"><strong>{{ c.title }}.</strong> {{ c.caption }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <section id="testing-approach">
    <h2>Testing Approach</h2>
    <p>{{ approach_html }}</p>
  </section>

  <section id="results-summary">
    <h2>Results Summary</h2>
    <div class="metrics-row">
      {% for m in report.key_metrics %}
      <div class="metric-card">
        <div class="value">{{ m.value }}</div>
        <div class="label">{{ m.label }}</div>
        {% if m.sublabel %}<div class="sublabel">{{ m.sublabel }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% if results_charts %}
    <div class="chart-grid">
      {% for c in results_charts %}
      <div class="chart-card">
        <img src="data:image/png;base64,{{ c.base64_png }}" alt="{{ c.title }}">
        <div class="caption"><strong>{{ c.title }}.</strong> {{ c.caption }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% if other_charts %}
    <h3>Additional Charts</h3>
    <div class="chart-grid">
      {% for c in other_charts %}
      <div class="chart-card">
        <img src="data:image/png;base64,{{ c.base64_png }}" alt="{{ c.title }}">
        <div class="caption"><strong>{{ c.title }}.</strong> {{ c.caption }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  {% if high_risk_cases_html %}
  <section id="high-risk-cases">
    <h2>High-Risk Cases</h2>
    <p class="muted">Individual results from this run worth a reviewer's direct attention — not the full data (see Appendix), just the cases where the outcome itself is the finding.</p>
    <ul class="report-list highlight">
      {% for c in high_risk_cases_html %}<li>{{ c }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  <section id="next-steps">
    <h2>Next Steps</h2>
    <ul class="report-list">
      {% for n in next_steps_html %}<li>{{ n }}</li>{% endfor %}
    </ul>
  </section>

  {% for extra in report.extra_sections %}
  <section>
    <h2>{{ extra.title }}</h2>
    {{ extra.html | safe }}
  </section>
  {% endfor %}

  <section id="appendix">
    <h2>Appendix</h2>
    <p class="muted">The full underlying data behind Results Summary above — every row, not just the highlights — plus a live-checked record of every file this run read or produced.</p>
    {% for title, table_html in results_tables_html %}
    <details class="appendix-block" open>
      <summary>{{ title }}</summary>
      {{ table_html | safe }}
    </details>
    {% endfor %}
    {% if artifacts_table_html %}
    <details class="appendix-block" open>
      <summary>Artifacts &amp; documentation trail</summary>
      {{ artifacts_table_html | safe }}
    </details>
    {% endif %}
  </section>

  <footer>
    Generated by <a href="https://github.com/minw0607/genai_alignment">genai_alignment</a> — scenario-based alignment testing for enterprise GenAI systems. This is a uniform report template shared across every scenario in the library.
  </footer>

</div>
</body>
</html>
